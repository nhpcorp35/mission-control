# HAL Sync Service — local configuration
# Copy to config.env (install.sh does this when missing) and edit paths.
# This file is machine-specific; config.env is gitignored.

# Absolute path(s) to local Git repositories to sync.
# Separate multiple paths with newlines (preferred) or spaces.
# Example path for Allen's Mac:
HAL_SYNC_REPOS="/Users/allenk/Desktop/Mission-Control"

# How often launchd should invoke sync (seconds). Default: 60.
HAL_SYNC_INTERVAL_SECONDS=60

# Directory for sync logs and the run lock. Default: <service>/logs
# HAL_SYNC_LOG_DIR=

# Max log file size in bytes before simple rotation (default: 1 MiB).
HAL_SYNC_LOG_MAX_BYTES=1048576

# Optional override for the lock directory path (default: $HAL_SYNC_LOG_DIR/hal-sync.lock).
# HAL_SYNC_LOCK_DIR=
